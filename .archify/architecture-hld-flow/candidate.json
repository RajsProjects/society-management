  "cards": [
    {
      "dot": "cyan",
      "title": "Multi-Tenant Isolation",
      "items": [
        "JwtAuthenticationFilter extracts tenant context (societyId) from token claims and sets TenantContext ThreadLocal",
        "SubscriptionEnforcementFilter gates requests to ensure active subscription or valid 14-day trial",
        "Repository queries enforce tenant partitioning across MongoDB collections (users, flats, bills, issues)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Core Domain Services",
      "items": [
        "Auth & Invites: Secure onboarding with BCrypt passwords and cryptographically signed invite tokens",
        "Maintenance Billing: Monthly automated invoicing with cron-driven auto-overdue transitions",
        "Civic Democracy: Resident issue polling with quorum-based voting and complaint lifecycle management"
      ]
    },
    {
      "dot": "rose",
      "title": "Integrations & Asynchrony",
      "items": [
        "Razorpay: Dual-purpose payment gateway for society SaaS subscriptions and resident maintenance bills",
        "AWS S3: Cloud object storage for society registration proof documents with presigned URLs",
        "Async Email Engine: Thymeleaf-rendered HTML notifications dispatched via Spring ApplicationEvents"
      ]
    }
  ]
